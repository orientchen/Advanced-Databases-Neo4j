{
  "name": "CSCI 480 / CIS 680 Neo4j",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8501,
    7474,
    7687
  ],
  "portsAttributes": {
    "7474": {
      "label": "Neo4j Browser (open /browser/)",
      "onAutoForward": "ignore",
      "visibility": "private"
    },
    "7687": {
      "label": "Neo4j Bolt (database connection)",
      "onAutoForward": "ignore",
      "visibility": "private"
    },
    "8501": {
      "label": "Cypher Practice (open this)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postStartCommand": "docker compose up -d --build",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml"
      ]
    }
  }
}
